#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Q6_K logits projection: same dequant+matmul as matmul_q6_k but the output is
// FP32 (the vocab-sized logits). Used when the lm_head (output.weight) is Q6_K
// (the Q4_K_M case). See matmul_q6_k.comp for the block layout and ordering.
layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer A { float16_t a[]; };  // [in_dim]
layout(std430, binding = 1) readonly buffer W { uint q[]; };       // Q6_K bytes
layout(std430, binding = 2) writeonly buffer Y { float y[]; };     // [out_dim]

layout(push_constant) uniform P { uint in_dim; uint out_dim; } p;

uint gb(uint b) { return (q[b >> 2u] >> ((b & 3u) * 8u)) & 0xFFu; }
float hf(uint b) { return unpackHalf2x16(gb(b) | (gb(b + 1u) << 8u)).x; }
int s8(uint b) { int v = int(gb(b)); return v >= 128 ? v - 256 : v; }

void main() {
    uint o = gl_GlobalInvocationID.x;
    if (o >= p.out_dim) return;
    uint nsb = p.in_dim / 256u;
    float acc = 0.0;
    for (uint s = 0u; s < nsb; s++) {
        uint blk = (o * nsb + s) * 210u;
        uint qlo = blk;
        uint qho = blk + 128u;
        uint sco = blk + 192u;
        float d = hf(blk + 208u);
        uint abase = s * 256u;
        for (uint n = 0u; n < 256u; n += 128u) {
            uint seg = n / 128u;
            uint qlb = qlo + seg * 64u;
            uint qhb = qho + seg * 32u;
            uint scb = sco + seg * 8u;
            for (uint l = 0u; l < 32u; l++) {
                uint is = l / 16u;
                uint lo0 = gb(qlb + l);
                uint lo1 = gb(qlb + l + 32u);
                uint h = gb(qhb + l);
                int q1 = int((lo0 & 0xFu) | (((h >> 0u) & 3u) << 4u)) - 32;
                int q2 = int((lo1 & 0xFu) | (((h >> 2u) & 3u) << 4u)) - 32;
                int q3 = int((lo0 >> 4u) | (((h >> 4u) & 3u) << 4u)) - 32;
                int q4 = int((lo1 >> 4u) | (((h >> 6u) & 3u) << 4u)) - 32;
                acc += d * float(s8(scb + is + 0u)) * float(q1) * float(a[abase + n + l + 0u]);
                acc += d * float(s8(scb + is + 2u)) * float(q2) * float(a[abase + n + l + 32u]);
                acc += d * float(s8(scb + is + 4u)) * float(q3) * float(a[abase + n + l + 64u]);
                acc += d * float(s8(scb + is + 6u)) * float(q4) * float(a[abase + n + l + 96u]);
            }
        }
    }
    y[o] = acc;
}
