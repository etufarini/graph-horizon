#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Q8_0 logits projection: same dequant+matmul as matmul_q8_0 but the output is
// FP32 (the vocab-sized logits). Reached when the lm_head (output.weight) is Q8_0
// — the tied-embedding case of a Q8_0 causal model (lm_head == token_embd). See
// matmul_q8_0.comp for the block layout and ordering.
layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer A { float16_t a[]; };  // [in_dim]
layout(std430, binding = 1) readonly buffer W { uint q[]; };       // Q8_0 bytes
layout(std430, binding = 2) writeonly buffer Y { float y[]; };     // [out_dim]

layout(push_constant) uniform P { uint in_dim; uint out_dim; } p;

// One byte at absolute byte address b within the raw weight buffer.
uint gb(uint b) { return (q[b >> 2u] >> ((b & 3u) * 8u)) & 0xFFu; }
// FP16 at byte address b (two little-endian bytes) decoded to FP32.
float hf(uint b) { return unpackHalf2x16(gb(b) | (gb(b + 1u) << 8u)).x; }

void main() {
    uint o = gl_GlobalInvocationID.x;
    if (o >= p.out_dim) return;
    uint nb = p.in_dim / 32u;             // blocks per output row
    float acc = 0.0;
    for (uint s = 0u; s < nb; s++) {
        uint blk = (o * nb + s) * 34u;    // byte base of this Q8_0 block
        float d = hf(blk);
        uint qso = blk + 2u;              // 32 int8 quants
        uint abase = s * 32u;
        float sum = 0.0;                  // Σ(q_j * a_j) for this block, FP32
        for (uint l = 0u; l < 32u; l++) {
            int qv = bitfieldExtract(int(gb(qso + l)), 0, 8);
            sum += float(qv) * float(a[abase + l]);
        }
        acc += d * sum;
    }
    y[o] = acc;
}
