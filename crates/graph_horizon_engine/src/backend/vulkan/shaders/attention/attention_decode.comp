#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

// AGENTS deroga K: kernel numerico della sola attention decode F16.

// Causal GQA attention for the current token (batch 1), softmax fused via the online
// (flash) algorithm. A workgroup normally owns one query head; the 1024-thread
// variant packs two adjacent GQA heads so their identical K/V reads share one wave.
// The cached positions 0..=pos are split across the workgroup's subgroups.
//
// Subgroup g streams t = g, g+G, ... <= pos. Its lanes are partitioned evenly among
// the packed heads; an XOR reduction stays inside each power-of-two partition. Each
// partition keeps its own online-softmax state in registers. The G partial states
// per head are combined once after the only workgroup barrier.
//
// vs the previous one-thread-per-dim kernel this removes ~3 barriers PER cached
// position (the dominant cost of the serial loop at long context) and cuts the
// serial depth from pos to pos/G. The sum is grouped differently (numerics-changing,
// f32-oracle gated, f16-level drift), not bit-identical.
//
// Invariants: head_dim <= 128; packed heads are adjacent inside one even-sized GQA
// group. The packed variant is capability-gated to subgroup sizes >= 32 and shuffle
// support; fallback variants use one head and subgroup arithmetic as before.
#ifndef ATTENTION_LOCAL_SIZE
#define ATTENTION_LOCAL_SIZE 256
#endif
#ifndef ATTENTION_GQA_HEADS
#define ATTENTION_GQA_HEADS 1
#endif
#if ATTENTION_GQA_HEADS > 1
#extension GL_KHR_shader_subgroup_shuffle : require
#endif
layout(local_size_x = ATTENTION_LOCAL_SIZE) in;

layout(std430, binding = 0) readonly buffer Q { float16_t q[]; };   // [q_heads*head_dim]
layout(std430, binding = 1) readonly buffer KC { float16_t kc[]; };
layout(std430, binding = 2) readonly buffer VC { float16_t vc[]; };
layout(std430, binding = 3) writeonly buffer O { float16_t o[]; };  // [q_heads*head_dim]

layout(push_constant) uniform P {
    uint head_dim;
    uint kv_heads;
    uint q_heads;
    uint pos;
    uint layer;
    uint context;
    float scale;
} p;

const uint PACKED_HEADS = uint(ATTENTION_GQA_HEADS);
const uint MAX_DPL = 8u;
// Both the one-head S>=16 fallback and two-head S>=32 variant have <=64 partials.
const uint MAX_PARTIALS = uint(ATTENTION_LOCAL_SIZE) / 16u;

shared float sh_m[MAX_PARTIALS];
shared float sh_l[MAX_PARTIALS];
shared float sh_acc[MAX_PARTIALS * 128u];

void main() {
    uint S = gl_SubgroupSize;
    uint lane_width = S / PACKED_HEADS;
    uint head_slot = gl_SubgroupInvocationID / lane_width;
    uint lane = gl_SubgroupInvocationID % lane_width;
    uint h = gl_WorkGroupID.x * PACKED_HEADS + head_slot;
    if (h >= p.q_heads) return;

    uint G = gl_NumSubgroups;
    uint g = gl_SubgroupID;

    uint group = p.q_heads / p.kv_heads;  // GQA ratio
    uint kvh = h / group;

    // This lane's owned head_dim components inside its query-head partition.
    float qd[MAX_DPL];
    float acc[MAX_DPL];
    uint dpl = 0u;
    for (uint j = 0u; j < MAX_DPL; j++) {
        uint d = lane + j * lane_width;
        qd[j] = (d < p.head_dim) ? float(q[h * p.head_dim + d]) : 0.0;
        acc[j] = 0.0;
        if (d < p.head_dim) dpl = j + 1u;
    }

    // Online softmax over this subgroup's strided KV subset (registers only).
    float m_g = -1e30;
    float l_g = 0.0;
    for (uint t = g; t <= p.pos; t += G) {
        uint kbase = ((p.layer * p.context + t) * p.kv_heads + kvh) * p.head_dim;
        float prod = 0.0;
        for (uint j = 0u; j < dpl; j++) {
            prod += qd[j] * float(kc[kbase + lane + j * lane_width]);
        }
#if ATTENTION_GQA_HEADS > 1
        for (uint offset = 1u; offset < lane_width; offset <<= 1u) {
            prod += subgroupShuffleXor(prod, offset);
        }
        float score = prod * p.scale;
#else
        float score = subgroupAdd(prod) * p.scale;  // full dot, broadcast to all lanes
#endif
        float m_new = max(m_g, score);
        float alpha = exp(m_g - m_new);
        float pw = exp(score - m_new);
        l_g = l_g * alpha + pw;
        for (uint j = 0u; j < dpl; j++) {
            acc[j] = acc[j] * alpha + pw * float(vc[kbase + lane + j * lane_width]);
        }
        m_g = m_new;
    }

    // Publish this subgroup's partial state for the cross-subgroup combine.
    uint partial = g * PACKED_HEADS + head_slot;
    if (lane == 0u) { sh_m[partial] = m_g; sh_l[partial] = l_g; }
    for (uint j = 0u; j < dpl; j++) {
        sh_acc[partial * p.head_dim + lane + j * lane_width] = acc[j];
    }
    barrier();

    // Subgroup 0 finalizes every packed head, one lane partition per head.
    if (g == 0u) {
        float m_glob = -1e30;
        for (uint gg = 0u; gg < G; gg++) {
            m_glob = max(m_glob, sh_m[gg * PACKED_HEADS + head_slot]);
        }
        float l_glob = 0.0;
        for (uint gg = 0u; gg < G; gg++) {
            uint part = gg * PACKED_HEADS + head_slot;
            l_glob += sh_l[part] * exp(sh_m[part] - m_glob);
        }
        for (uint j = 0u; j < dpl; j++) {
            uint d = lane + j * lane_width;
            float num = 0.0;
            for (uint gg = 0u; gg < G; gg++) {
                uint part = gg * PACKED_HEADS + head_slot;
                num += sh_acc[part * p.head_dim + d] * exp(sh_m[part] - m_glob);
            }
            o[h * p.head_dim + d] = float16_t(num / l_glob);
        }
    }
}
