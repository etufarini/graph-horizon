#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

// AGENTS deroga K: kernel numerico della sola attention prefill F16.

// Causal GQA attention for N query in a single dispatch — the N-query generalization
// of attention_decode.comp, with the same flash KV-parallel structure. Grid is 2D
// (q_heads, n): workgroup (h, i) handles query head h of row i (absolute position
// pos = base + i), attending cached positions 0..=pos. The cached positions are split
// across the workgroup's subgroups (subgroup g streams t = g, g+G, ...), each keeping
// its own online-softmax state over its owned head_dim components in registers; the G
// partials are combined once at the end. This removes the per-position workgroup
// barriers and cuts the serial KV depth from pos to pos/G. q/out are N-wide
// [n][q_heads][head_dim]; cache layout is [layer][token][kv_head][head_dim].
//
// Numerics-changing (grouped/reordered softmax sum, f16-level drift), gated by the
// f32 oracle. See attention_decode.comp for the invariants (head_dim <= 128, etc.).
// A 256-thread group supplies four subgroups on wave64 hardware and eight on
// subgroup-32 hardware, reducing each subgroup's serial KV span.
layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer Q { float16_t q[]; };   // [n*q_heads*head_dim]
layout(std430, binding = 1) readonly buffer KC { float16_t kc[]; };
layout(std430, binding = 2) readonly buffer VC { float16_t vc[]; };
layout(std430, binding = 3) writeonly buffer O { float16_t o[]; };  // [n*q_heads*head_dim]

layout(push_constant) uniform P {
    uint head_dim;
    uint kv_heads;
    uint q_heads;
    uint base;
    uint n;
    uint layer;
    uint context;
    float scale;
} p;

const uint MAX_DPL = 8u;
const uint MAX_G = 16u;

shared float sh_m[MAX_G];
shared float sh_l[MAX_G];
shared float sh_acc[MAX_G * 128u];

void main() {
    uint h = gl_WorkGroupID.x;  // query head
    uint i = gl_WorkGroupID.y;  // query row in the batch
    if (h >= p.q_heads || i >= p.n) return;

    uint S = gl_SubgroupSize;
    uint G = gl_NumSubgroups;
    uint g = gl_SubgroupID;
    uint l = gl_SubgroupInvocationID;

    uint pos = p.base + i;                  // absolute position of this row
    uint group = p.q_heads / p.kv_heads;    // GQA ratio
    uint kvh = h / group;
    uint row = i * p.q_heads * p.head_dim;  // N-wide offset into q/out

    // This lane's owned head_dim components: d = l + j*S (j = 0..dpl-1), d < head_dim.
    float qd[MAX_DPL];
    float acc[MAX_DPL];
    uint dpl = 0u;
    for (uint j = 0u; j < MAX_DPL; j++) {
        uint d = l + j * S;
        qd[j] = (d < p.head_dim) ? float(q[row + h * p.head_dim + d]) : 0.0;
        acc[j] = 0.0;
        if (d < p.head_dim) dpl = j + 1u;
    }

    float m_g = -1e30;
    float l_g = 0.0;
    for (uint t = g; t <= pos; t += G) {
        uint kbase = ((p.layer * p.context + t) * p.kv_heads + kvh) * p.head_dim;
        float prod = 0.0;
        for (uint j = 0u; j < dpl; j++) {
            prod += qd[j] * float(kc[kbase + l + j * S]);
        }
        float score = subgroupAdd(prod) * p.scale;
        float m_new = max(m_g, score);
        float alpha = exp(m_g - m_new);
        float pw = exp(score - m_new);
        l_g = l_g * alpha + pw;
        for (uint j = 0u; j < dpl; j++) {
            acc[j] = acc[j] * alpha + pw * float(vc[kbase + l + j * S]);
        }
        m_g = m_new;
    }

    if (subgroupElect()) { sh_m[g] = m_g; sh_l[g] = l_g; }
    for (uint j = 0u; j < dpl; j++) {
        sh_acc[g * p.head_dim + l + j * S] = acc[j];
    }
    barrier();

    if (g == 0u) {
        float m_glob = -1e30;
        for (uint gg = 0u; gg < G; gg++) { m_glob = max(m_glob, sh_m[gg]); }
        float l_glob = 0.0;
        for (uint gg = 0u; gg < G; gg++) { l_glob += sh_l[gg] * exp(sh_m[gg] - m_glob); }
        for (uint j = 0u; j < dpl; j++) {
            uint d = l + j * S;
            float num = 0.0;
            for (uint gg = 0u; gg < G; gg++) {
                num += sh_acc[gg * p.head_dim + d] * exp(sh_m[gg] - m_glob);
            }
            o[row + h * p.head_dim + d] = float16_t(num / l_glob);
        }
    }
}
