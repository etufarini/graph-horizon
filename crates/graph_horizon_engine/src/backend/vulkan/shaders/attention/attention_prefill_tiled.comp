#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

// AGENTS deroga K: kernel numerico della sola attention prefill F16 tiled.

// Causal GQA prefill attention for four adjacent rows and two query heads that
// share one KV head. A 512-thread
// workgroup loads one 64-position tile in two phases: K produces shared scores,
// then V consumes shared softmax weights. K and V therefore reuse the same 16 KiB
// workgroup tile. Eight query states share the load; history keys are distributed
// across two subgroups/state and every invocation owns two output dimensions.
// Q/output are [n][q_heads][head_dim]; cache is
// [layer][context][kv_heads][head_dim]. Decode and INT8 use other kernels.
layout(local_size_x = 512) in;

layout(std430, binding = 0) readonly buffer Q { float16_t q[]; };
layout(std430, binding = 1) readonly buffer KC { float16_t kc[]; };
layout(std430, binding = 2) readonly buffer VC { float16_t vc[]; };
layout(std430, binding = 3) writeonly buffer O { float16_t o[]; };

layout(push_constant) uniform P {
    uint head_dim;
    uint kv_heads;
    uint q_heads;
    uint base;
    uint n;
    uint layer;
    uint context;
    float scale;
} p;

const uint ROW_TILE = 4u;
const uint HEAD_TILE = 2u;
const uint QUERY_TILE = ROW_TILE * HEAD_TILE;
const uint KV_TILE = 64u;
const uint MAX_DPL = 8u;
const uint OUTPUT_DPL = 2u;

shared float16_t sh_tile[KV_TILE * 128u];
shared float16_t sh_q[QUERY_TILE * 128u];
shared float sh_score[QUERY_TILE * KV_TILE];
shared float sh_m[QUERY_TILE];
shared float sh_l[QUERY_TILE];
shared float sh_alpha[QUERY_TILE];

void main() {
    uint first_h = gl_WorkGroupID.x * HEAD_TILE;
    uint first = gl_WorkGroupID.y * ROW_TILE;
    if (first_h >= p.q_heads || first >= p.n) return;

    uint S = gl_SubgroupSize;
    uint G = gl_NumSubgroups;
    uint g = gl_SubgroupID;
    uint lane = gl_SubgroupInvocationID;
    uint rows = min(ROW_TILE, p.n - first);
    uint heads = min(HEAD_TILE, p.q_heads - first_h);
    uint key_parts = G / QUERY_TILE;
    uint query = g / key_parts;
    uint part = g % key_parts;
    uint query_head = query / ROW_TILE;
    uint query_index = query % ROW_TILE;
    bool valid_query = query_head < heads && query_index < rows;

    uint group = p.q_heads / p.kv_heads;
    uint h = first_h + min(query_head, heads - 1u);
    uint kvh = first_h / group;
    uint query_row = first + min(query_index, rows - 1u);
    uint row = query_row * p.q_heads * p.head_dim;
    uint pos = p.base + query_row;
    uint last_pos = p.base + first + rows - 1u;

    // Q is shared because every history-partition subgroup for the same query
    // computes independent scores from the same vector.
    uint query_elements = QUERY_TILE * p.head_dim;
    for (uint index = gl_LocalInvocationIndex; index < query_elements; index += 512u) {
        uint state = index / p.head_dim;
        uint d = index - state * p.head_dim;
        uint state_head = state / ROW_TILE;
        uint state_row = state % ROW_TILE;
        if (state_head < heads && state_row < rows) {
            uint source_h = first_h + state_head;
            uint source_row = first + state_row;
            sh_q[index] = q[(source_row * p.q_heads + source_h) * p.head_dim + d];
        } else {
            sh_q[index] = float16_t(0.0);
        }
    }
    if (gl_LocalInvocationIndex < QUERY_TILE) {
        sh_m[gl_LocalInvocationIndex] = -1e30;
        sh_l[gl_LocalInvocationIndex] = 0.0;
        sh_alpha[gl_LocalInvocationIndex] = 1.0;
    }
    barrier();

    // With two key subgroups/state on subgroup 32, each lane owns two output
    // dimensions. Temporal and GQA reuse therefore have the same live-state cost.
    float acc[OUTPUT_DPL];
    for (uint j = 0u; j < OUTPUT_DPL; j++) acc[j] = 0.0;

    for (uint tile = 0u; tile <= last_pos; tile += KV_TILE) {
        uint count = min(KV_TILE, last_pos + 1u - tile);
        uint elements = count * p.head_dim;
        for (uint index = gl_LocalInvocationIndex; index < elements; index += 512u) {
            uint key = index / p.head_dim;
            uint d = index - key * p.head_dim;
            uint cache = ((p.layer * p.context + tile + key) * p.kv_heads + kvh)
                       * p.head_dim + d;
            sh_tile[index] = kc[cache];
        }
        barrier();

        // Full history tiles avoid the per-key causal comparison. Only the
        // diagonal tile takes the partial path for each query.
        bool full_tile = valid_query && tile + count - 1u <= pos;
        for (uint key = part; key < count; key += key_parts) {
            float score = -1e30;
            if (full_tile || (valid_query && tile + key <= pos)) {
                float product = 0.0;
                for (uint j = 0u; j < MAX_DPL; j++) {
                    uint d = lane + j * S;
                    if (d < p.head_dim) {
                        product += float(sh_q[query * p.head_dim + d])
                                 * float(sh_tile[key * p.head_dim + d]);
                    }
                }
                score = subgroupAdd(product) * p.scale;
            }
            if (subgroupElect()) sh_score[query * KV_TILE + key] = score;
        }
        barrier();

        // The first subgroup of each query converts scores to online-softmax
        // weights. Each lane owns strided scores, so tiles may exceed subgroup
        // width without another workgroup reduction.
        if (valid_query && part == 0u) {
            float lane_m = -1e30;
            for (uint key = lane; key < count; key += S) {
                lane_m = max(lane_m, sh_score[query * KV_TILE + key]);
            }
            float tile_m = subgroupMax(lane_m);
            float m_new = max(sh_m[query], tile_m);
            float lane_l = 0.0;
            for (uint key = lane; key < count; key += S) {
                float weight = exp(sh_score[query * KV_TILE + key] - m_new);
                sh_score[query * KV_TILE + key] = weight;
                lane_l += weight;
            }
            float tile_l = subgroupAdd(lane_l);
            float alpha = exp(sh_m[query] - m_new);
            if (subgroupElect()) {
                sh_alpha[query] = alpha;
                sh_l[query] = sh_l[query] * alpha + tile_l;
                sh_m[query] = m_new;
            }
        }

        // All K reads finished at the preceding barrier, so V may overwrite the
        // shared tile while the elected subgroups transform independent scores.
        for (uint index = gl_LocalInvocationIndex; index < elements; index += 512u) {
            uint key = index / p.head_dim;
            uint d = index - key * p.head_dim;
            uint cache = ((p.layer * p.context + tile + key) * p.kv_heads + kvh)
                       * p.head_dim + d;
            sh_tile[index] = vc[cache];
        }
        barrier();

        if (valid_query) {
            for (uint j = 0u; j < OUTPUT_DPL; j++) {
                uint d = part * S + lane + j * key_parts * S;
                if (d >= p.head_dim) continue;
                acc[j] *= sh_alpha[query];
                for (uint key = 0u; key < count; key++) {
                    acc[j] += sh_score[query * KV_TILE + key]
                            * float(sh_tile[key * p.head_dim + d]);
                }
            }
        }
        // The V tile remains live until every output owner finishes consuming it.
        barrier();
    }

    if (valid_query) {
        for (uint j = 0u; j < OUTPUT_DPL; j++) {
            uint d = part * S + lane + j * key_parts * S;
            if (d < p.head_dim) {
                o[row + h * p.head_dim + d] = float16_t(acc[j] / sh_l[query]);
            }
        }
    }
}
