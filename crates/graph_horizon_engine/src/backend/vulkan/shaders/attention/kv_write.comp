#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// AGENTS deroga K: kernel numerico della sola scrittura KV F16.

// Writes the current token's K and V (each [kv_heads*head_dim]) into the KV
// cache at a precomputed element offset for (layer, pos). The CPU side computes
// dst_offset so the cache layout stays in one place (kv_cache.rs).
layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer K { float16_t k[]; };
layout(std430, binding = 1) readonly buffer V { float16_t v[]; };
layout(std430, binding = 2) buffer KC { float16_t kc[]; };
layout(std430, binding = 3) buffer VC { float16_t vc[]; };

layout(push_constant) uniform P { uint dst_offset; uint count; } p;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.count) return;
    kc[p.dst_offset + i] = k[i];
    vc[p.dst_offset + i] = v[i];
}
