#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// AGENTS deroga K: kernel numerico della sola attivazione fused SiLU-mul.

// Fused SiLU(gate) ⊙ up: o[i] = f16(f16(silu(gate[i])) * up[i]). The graph
// contract requires the SiLU intermediate to round through FP16 memory before
// the product. On RADV that FP16 store is
// also what pins the silu's exp/divide codegen, so an in-register round-trip
// (`float(float16_t(x))`, or pack/unpackHalf2x16) is NOT bit-exact — the optimizer
// recompiles the silu sub-ULP differently once its result feeds the multiply. So
// the shader uses a genuine memory round-trip: `o` is `volatile`, the SiLU result
// is stored to it, then re-read and multiplied. One dispatch, one buffer, and the
// same sequential FP16-rounded formula.
layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer G { float16_t g[]; };
layout(std430, binding = 1) readonly buffer U { float16_t u[]; };
layout(std430, binding = 2) volatile buffer O { float16_t o[]; };

layout(push_constant) uniform P { uint n; } p;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) return;
    float v = float(g[i]);
    // The volatile FP16 store is the required rounding boundary.
    o[i] = float16_t(v / (1.0 + exp(-v)));
    // Re-read the FP16 value (volatile ⇒ a real load) before multiplying by up.
    o[i] = float16_t(float(o[i]) * float(u[i]));
}
