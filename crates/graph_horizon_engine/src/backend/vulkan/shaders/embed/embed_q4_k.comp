#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// AGENTS deroga K: kernel numerico della sola lookup embedding Q4_K.

// Q4_K embedding lookup: dequantizes one row (`row`) of the Q4_K token_embd
// tensor [vocab, embd] into the FP32 residual stream. The row is `embd`
// contiguous weights = embd/256 Q4_K super-blocks at block index row*(embd/256).
// One invocation per super-block, writing its 256 dequantized values in GGML
// Q4_K block order.
layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer W { uint q[]; };     // Q4_K bytes
layout(std430, binding = 1) writeonly buffer Y { float y[]; };   // [embd] FP32 x

layout(push_constant) uniform P { uint row; uint embd; } p;

uint gb(uint b) { return (q[b >> 2u] >> ((b & 3u) * 8u)) & 0xFFu; }
float hf(uint b) { return unpackHalf2x16(gb(b) | (gb(b + 1u) << 8u)).x; }

void scale_min(uint sco, uint j, out uint sc, out uint mn) {
    if (j < 4u) {
        sc = gb(sco + j) & 63u;
        mn = gb(sco + j + 4u) & 63u;
    } else {
        uint hi = gb(sco + j + 4u);
        uint lo = gb(sco + j - 4u);
        sc = (hi & 0xFu) | ((lo >> 6u) << 4u);
        // min high bits come from q[j] (ggml get_scale_min_k4), not q[j-4].
        mn = (hi >> 4u) | ((gb(sco + j) >> 6u) << 4u);
    }
}

void main() {
    uint s = gl_GlobalInvocationID.x;
    uint nsb = p.embd / 256u;
    if (s >= nsb) return;
    uint blk = (p.row * nsb + s) * 144u;
    float d = hf(blk);
    float dmin = hf(blk + 2u);
    uint sco = blk + 4u;
    uint qso = blk + 16u;
    uint obase = s * 256u;
    uint is = 0u;
    uint qb = 0u;
    for (uint j = 0u; j < 256u; j += 64u) {
        uint sc1, mn1, sc2, mn2;
        scale_min(sco, is, sc1, mn1);
        scale_min(sco, is + 1u, sc2, mn2);
        float d1 = d * float(sc1);
        float m1 = dmin * float(mn1);
        float d2 = d * float(sc2);
        float m2 = dmin * float(mn2);
        for (uint l = 0u; l < 32u; l++) {
            uint qv = gb(qso + qb + l);
            y[obase + j + l] = d1 * float(qv & 0xFu) - m1;
            y[obase + j + 32u + l] = d2 * float(qv >> 4u) - m2;
        }
        qb += 32u;
        is += 2u;
    }
}
