#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// AGENTS deroga K: kernel numerico della sola proiezione logits F16.

// Final logits projection: y = lm_head * x. Same shape as matmul_fp16 but the
// output is FP32 (vocab-sized logits feed sampling/validation directly).
layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer X { float16_t x[]; };   // [in_dim]
layout(std430, binding = 1) readonly buffer W { float16_t w[]; };   // [out_dim*in_dim]
layout(std430, binding = 2) writeonly buffer Y { float y[]; };      // [out_dim] FP32

layout(push_constant) uniform P { uint in_dim; uint out_dim; } p;

void main() {
    uint o = gl_GlobalInvocationID.x;
    if (o >= p.out_dim) return;
    uint base = o * p.in_dim;
    float acc = 0.0;
    for (uint i = 0u; i < p.in_dim; i++) {
        acc += float(x[i]) * float(w[base + i]);
    }
    y[o] = acc;
}
