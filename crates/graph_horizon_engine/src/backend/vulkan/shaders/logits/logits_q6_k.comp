#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// AGENTS deroga K: kernel denso Q6_K per la proiezione logits FP32.

// Q6_K logits projection: four invocations cooperate on each vocabulary row,
// matching matmul_q6_k's 64-value split while retaining FP32 output. Used when
// the tied or dedicated lm_head is Q6_K.
layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer A { float16_t a[]; };  // [in_dim]
layout(std430, binding = 1) readonly buffer W { uint q[]; };       // Q6_K bytes
layout(std430, binding = 2) writeonly buffer Y { float y[]; };     // [out_dim]

layout(push_constant) uniform P { uint in_dim; uint out_dim; } p;

shared float asb[256];
shared float partial[256];

uint gb(uint b) { return (q[b >> 2u] >> ((b & 3u) * 8u)) & 0xFFu; }
float hf(uint b) { return unpackHalf2x16(gb(b) | (gb(b + 1u) << 8u)).x; }
int s8(uint b) { int v = int(gb(b)); return v >= 128 ? v - 256 : v; }
// Q6_K's 210-byte stride alternates aligned and half-word-aligned blocks.
uint packed4(uint b) {
    uint shift = (b & 3u) * 8u;
    uint lo = q[b >> 2u];
    return shift == 0u ? lo : (lo >> shift) | (q[(b >> 2u) + 1u] << (32u - shift));
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint row_local = tid >> 2u;
    uint lane = tid & 3u;
    uint o = gl_WorkGroupID.x * 64u + row_local;
    bool live = o < p.out_dim;
    uint nsb = p.in_dim / 256u;
    uint seg = lane >> 1u;
    uint pair = lane & 1u;
    uint nibble_shift = pair * 4u;
    uint scale_shift = pair * 4u;
    uint activation_shift = seg * 128u + pair * 64u;
    float acc = 0.0;

    for (uint s = 0u; s < nsb; s++) {
        asb[tid] = float(a[s * 256u + tid]);
        barrier();

        if (live) {
            uint blk = (o * nsb + s) * 210u;
            uint qlo = blk;
            uint qho = blk + 128u;
            uint sco = blk + 192u;
            float d = hf(blk + 208u);
            uint qlb = qlo + seg * 64u;
            uint qhb = qho + seg * 32u;
            uint scb = sco + seg * 8u;
            float q0_scale_0 = d * float(s8(scb + scale_shift));
            float q0_scale_1 = d * float(s8(scb + scale_shift + 1u));
            float q1_scale_0 = d * float(s8(scb + scale_shift + 2u));
            float q1_scale_1 = d * float(s8(scb + scale_shift + 3u));
            // Four packed loads replace twelve repeated byte-extracting loads;
            // u,b still visit l=0..31 in the original accumulation order.
            for (uint u = 0u; u < 8u; u++) {
                uint lo0 = packed4(qlb + u * 4u);
                uint lo1 = packed4(qlb + 32u + u * 4u);
                uint hi = packed4(qhb + u * 4u);
                float q0_scale = u < 4u ? q0_scale_0 : q0_scale_1;
                float q1_scale = u < 4u ? q1_scale_0 : q1_scale_1;
                for (uint b = 0u; b < 4u; b++) {
                    uint l = u * 4u + b;
                    uint byte_shift = b * 8u;
                    uint lo0_byte = (lo0 >> byte_shift) & 0xFFu;
                    uint lo1_byte = (lo1 >> byte_shift) & 0xFFu;
                    uint hi_byte = (hi >> byte_shift) & 0xFFu;
                    int q0 = int(((lo0_byte >> nibble_shift) & 0xFu) |
                                 (((hi_byte >> scale_shift) & 3u) << 4u)) - 32;
                    int q1 = int(((lo1_byte >> nibble_shift) & 0xFu) |
                                 (((hi_byte >> (scale_shift + 2u)) & 3u) << 4u)) - 32;
                    acc += q0_scale * float(q0) * asb[activation_shift + l];
                    acc += q1_scale * float(q1) * asb[activation_shift + l + 32u];
                }
            }
        }
        barrier();
    }

    partial[tid] = acc;
    barrier();
    if (lane == 0u && live) {
        y[o] = partial[tid] + partial[tid + 1u] + partial[tid + 2u] + partial[tid + 3u];
    }
}
