#version 450
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// AGENTS deroga K: kernel numerico della sola operazione matmul Q4_K cooperativa.

// Cooperative-matrix dense prefill path. `matmul_batched_q4k` feeds A as FP16
// token-major and expects Y as FP16 token-major `[n][out_dim]`. The shader uses
// 16×16×16 FP16→FP32 MMA and shared Q4_K→FP16 dequantization, narrowing the FP32
// accumulator only on store. The only added
// error vs the f32 oracle is the f16 rounding of A and the dequantized weights — within the
// Q4_K+f16 tolerance the batched f16-out path already carries.
//
// Math: y[col][grow] = Σ_k A[col][k]·W[grow][k]; C(MxN)=A(MxK)·B(KxN), M=positions (n),
// N=output rows (out_dim), K=in_dim, B[k][n]=dequant(W[n][k]). A token-major float16_t
// a[col*in_dim+k]; W Q4_K row-major; Y token-major float16_t y[col*out_dim+grow]. Fixed
// 16×16×16 shape (the device's f16→f32 subgroup shape on the Ampere bench target); the
// routing selects this only when the detected CoopmatCaps match it, else the batched
// f16-out fallback. Two 32-lane subgroups consume adjacent prompt tiles while sharing
// one dequantized B tile, so every Q4_K weight is unpacked once per 32-row batch.
layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer A { float16_t a[]; };   // [n][in_dim] token-major
layout(std430, binding = 1) readonly buffer W { uint q[]; };        // Q4_K bytes
layout(std430, binding = 2) writeonly buffer Y { float16_t y[]; };  // [n][out_dim] token-major

layout(push_constant) uniform P { uint in_dim; uint out_dim; uint n; } p;

const uint T = 16u;  // MMA tile (M=N=K=16)
const uint SUBGROUPS = 2u;

shared float16_t as_[SUBGROUPS * T * T]; // Two A tiles [M][K], one per subgroup.
shared float16_t bs[T * T];              // Shared B tile [K][N], B[k][n]=W[n][k].
shared float cs[SUBGROUPS * T * T];       // Two C tiles [M][N], one per subgroup.

uint gb(uint b) { return (q[b >> 2u] >> ((b & 3u) * 8u)) & 0xFFu; }
float hf(uint b) { return unpackHalf2x16(gb(b) | (gb(b + 1u) << 8u)).x; }

void scale_min(uint sco, uint j, out uint sc, out uint mn) {
    if (j < 4u) {
        sc = gb(sco + j) & 63u;
        mn = gb(sco + j + 4u) & 63u;
    } else {
        uint hi = gb(sco + j + 4u);
        uint lo = gb(sco + j - 4u);
        sc = (hi & 0xFu) | ((lo >> 6u) << 4u);
        mn = (hi >> 4u) | ((gb(sco + j) >> 6u) << 4u);
    }
}

float dequant_w(uint row, uint k, uint nsb) {
    uint s = k >> 8u;
    uint kk = k & 255u;
    uint blk = (row * nsb + s) * 144u;
    float d = hf(blk);
    float dmin = hf(blk + 2u);
    uint sco = blk + 4u;
    uint qso = blk + 16u;
    uint jb = kk >> 6u;
    uint rem = kk & 63u;
    uint sub = jb * 2u + (rem >> 5u);
    uint l = rem & 31u;
    uint byteval = gb(qso + jb * 32u + l);
    uint qv = (rem < 32u) ? (byteval & 0xFu) : (byteval >> 4u);
    uint sc, mn;
    scale_min(sco, sub, sc, mn);
    return d * float(sc) * float(qv) - dmin * float(mn);
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint subgroup = tid / 32u;
    uint lane = tid % 32u;
    uint nsb = p.in_dim / 256u;
    uint col_base = gl_WorkGroupID.x * (SUBGROUPS * T) + subgroup * T;
    uint row_base = gl_WorkGroupID.y * T;  // first output row (N) of this tile
    uint a_offset = subgroup * T * T;
    uint c_offset = subgroup * T * T;

    coopmat<float, gl_ScopeSubgroup, T, T, gl_MatrixUseAccumulator> acc =
        coopmat<float, gl_ScopeSubgroup, T, T, gl_MatrixUseAccumulator>(0.0);

    // in_dim is a multiple of 256 (Q4_K super-block), hence of T=16: K has no tail.
    for (uint kbase = 0u; kbase < p.in_dim; kbase += T) {
        for (uint li = lane; li < T * T; li += 32u) {
            uint mm = li / T;  // M (position)
            uint kk = li % T;  // K
            uint gcol = col_base + mm;
            as_[a_offset + li] = (gcol < p.n)
                ? a[gcol * p.in_dim + kbase + kk]
                : float16_t(0.0);
        }
        for (uint li = tid; li < T * T; li += 64u) {
            uint kk = li / T;  // K
            uint nn = li % T;  // N (output row)
            uint grow = row_base + nn;
            bs[li] = (grow < p.out_dim)
                ? float16_t(dequant_w(grow, kbase + kk, nsb))
                : float16_t(0.0);
        }
        barrier();

        coopmat<float16_t, gl_ScopeSubgroup, T, T, gl_MatrixUseA> matA;
        coopmat<float16_t, gl_ScopeSubgroup, T, T, gl_MatrixUseB> matB;
        coopMatLoad(matA, as_, a_offset, T, gl_CooperativeMatrixLayoutRowMajor);
        coopMatLoad(matB, bs, 0u, T, gl_CooperativeMatrixLayoutRowMajor);
        acc = coopMatMulAdd(matA, matB, acc);
        barrier();
    }

    // Store the f32 result tile to shared, then scatter guarded into Y, narrowing to f16.
    coopMatStore(acc, cs, c_offset, T, gl_CooperativeMatrixLayoutRowMajor);
    barrier();
    for (uint li = lane; li < T * T; li += 32u) {
        uint mm = li / T;
        uint nn = li % T;
        uint gcol = col_base + mm;
        uint grow = row_base + nn;
        if (gcol < p.n && grow < p.out_dim)
            y[gcol * p.out_dim + grow] = float16_t(cs[c_offset + li]);
    }
}
