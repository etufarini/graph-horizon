#version 450
#extension GL_EXT_integer_dot_product : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// AGENTS deroga K: kernel numerico della sola operazione matmul Q4_K MMVQ.

// Dense FP16-output MMVQ decode GEMV. Eight lanes own one output row, one lane
// per 32-value Q4_K group. Each lane consumes four 8-value activation blocks;
// thirty-two rows share a workgroup and reduce into one FP16 result per row.
layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer Qs { uint qa[]; };      // [in_dim/4] packed int8 Q8
layout(std430, binding = 1) readonly buffer Ds { float ds[]; };     // [2 per block] (d, s)
layout(std430, binding = 2) readonly buffer W { uint q[]; };        // Q4_K bytes
layout(std430, binding = 3) writeonly buffer Y { float16_t y[]; };  // [out_dim] f16

layout(push_constant) uniform P { uint in_dim; uint out_dim; } p;

shared float partial[256];

uint gb(uint b) { return (q[b >> 2u] >> ((b & 3u) * 8u)) & 0xFFu; }
float hf(uint b) { return unpackHalf2x16(gb(b) | (gb(b + 1u) << 8u)).x; }

void scale_min(uint sco, uint j, out uint sc, out uint mn) {
    if (j < 4u) {
        sc = gb(sco + j) & 63u;
        mn = gb(sco + j + 4u) & 63u;
    } else {
        uint hi = gb(sco + j + 4u);
        uint lo = gb(sco + j - 4u);
        sc = (hi & 0xFu) | ((lo >> 6u) << 4u);
        mn = (hi >> 4u) | ((gb(sco + j) >> 6u) << 4u);
    }
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint row_local = tid >> 3u;
    uint lane = tid & 7u;
    uint o = gl_WorkGroupID.x * 32u + row_local;
    bool live = o < p.out_dim;
    uint nsb = p.in_dim / 256u;
    float acc = 0.0;
    for (uint s = 0u; s < nsb; s++) {
        if (live) {
            uint blk = (o * nsb + s) * 144u;
            uint sco = blk + 4u;
            uint qso = blk + 16u;
            uint sub = lane & 1u;
            uint qb = (lane >> 1u) * 32u;
            uint sc, mn;
            scale_min(sco, lane, sc, mn);
            for (uint part = 0u; part < 4u; part++) {
                uint ab = (s * 8u + lane) * 4u + part;
                int dot = 0;
                for (uint g = 0u; g < 2u; g++) {
                    uint packed = q[(qso + qb + (part * 2u + g) * 4u) >> 2u];
                    uint wq = sub == 0u
                        ? packed & 0x0F0F0F0Fu
                        : (packed >> 4u) & 0x0F0F0F0Fu;
                    dot = dotPacked4x8AccSatEXT(int(wq), int(qa[ab * 2u + g]), dot);
                }
                float d_a = ds[ab * 2u];
                float s_a = ds[ab * 2u + 1u];
                acc += hf(blk) * float(sc) * d_a * float(dot)
                    - hf(blk + 2u) * float(mn) * s_a;
            }
        }
    }
    partial[tid] = acc;
    barrier();
    if (lane == 0u && live) {
        float sum = partial[tid];
        for (uint i = 1u; i < 8u; i++) sum += partial[tid + i];
        y[o] = float16_t(sum);
    }
}
