#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// AGENTS deroga K: kernel numerico della sola operazione matmul Q4_K tiled.

// Tiled Q4_K matmul: y = W * a, batch 1, with a 4-lane split per output row.
//
// Tiling (fixed): workgroup 256 invocations, output tile = 64 rows, K-chunk = one
// Q4_K super-block (256 weights); the per-row reduction over the 4 lanes uses shared
// memory (no subgroup-arithmetic dependency, hardware-agnostic). The activation is
// read directly: the complete decode vector fits in cache, and this preserves the
// arithmetic order while avoiding two workgroup barriers per super-block.
//
// Lane map: tid = 4*row_local + lane. The 64 rows of a workgroup all read the SAME
// activation vector. Each row's 256 weights split across its 4 lanes by the four
// 64-weight j-blocks of the super-block (j = lane*64), matching the Q4_K dequant
// order exactly, so the value is bit-equivalent.
//
// Boundary: out_dim need not be a multiple of 64 — out-of-range rows still help
// stage the shared activation but write nothing. in_dim is always a multiple of 256
// (Q4_K), so the super-block count is exact.
layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer A { float16_t a[]; };   // [in_dim]
layout(std430, binding = 1) readonly buffer W { uint q[]; };        // Q4_K bytes
layout(std430, binding = 2) writeonly buffer Y { float16_t y[]; };  // [out_dim]

layout(push_constant) uniform P { uint in_dim; uint out_dim; } p;

// Per-lane partials for the four-way row reduction.
shared float partial[256];

// One byte at absolute byte address b within the raw weight buffer.
uint gb(uint b) { return (q[b >> 2u] >> ((b & 3u) * 8u)) & 0xFFu; }
// FP16 at byte address b (two little-endian bytes) decoded to FP32.
float hf(uint b) { return unpackHalf2x16(gb(b) | (gb(b + 1u) << 8u)).x; }

// 6-bit scale/min codes of sub-block j (0..7) from scales[12] at byte `sco`.
void scale_min(uint sco, uint j, out uint sc, out uint mn) {
    if (j < 4u) {
        sc = gb(sco + j) & 63u;
        mn = gb(sco + j + 4u) & 63u;
    } else {
        uint hi = gb(sco + j + 4u);
        uint lo = gb(sco + j - 4u);
        sc = (hi & 0xFu) | ((lo >> 6u) << 4u);
        mn = (hi >> 4u) | ((gb(sco + j) >> 6u) << 4u);
    }
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint row_local = tid >> 2u;            // 0..63
    uint lane = tid & 3u;                  // 0..3 → handles j-block j = lane*64
    uint o = gl_WorkGroupID.x * 64u + row_local;
    bool live = o < p.out_dim;

    uint nsb = p.in_dim / 256u;            // super-blocks per output row
    uint j = lane * 64u;                   // this lane's 64-weight j-block
    uint is = lane * 2u;                   // its first sub-block index (2 per j-block)
    uint qb = lane * 32u;                  // its byte offset into qs[128]
    float acc = 0.0;

    for (uint s = 0u; s < nsb; s++) {
        if (live) {
            uint blk = (o * nsb + s) * 144u; // byte base of this Q4_K block
            float d = hf(blk);
            float dmin = hf(blk + 2u);
            uint sco = blk + 4u;             // scales[12]
            uint qso = blk + 16u;            // qs[128]
            uint sc1, mn1, sc2, mn2;
            scale_min(sco, is, sc1, mn1);
            scale_min(sco, is + 1u, sc2, mn2);
            float d1 = d * float(sc1);
            float m1 = dmin * float(mn1);
            float d2 = d * float(sc2);
            float m2 = dmin * float(mn2);
            // Read this lane's 32 qs bytes as 8 uints (one global load each) instead
            // of 32 byte-extracting gb() calls that re-load the same uint 4×. qso+qb
            // is 4-aligned (qso=blk+16, qb=lane*32, blk a multiple of 144), so the
            // uint index is exact. Same qv values and same accumulation order over
            // l=0..31 ⇒ bit-identical to the gb() loop.
            uint qbase = (qso + qb) >> 2u;
            for (uint u = 0u; u < 8u; u++) {
                uint word = q[qbase + u];
                for (uint b = 0u; b < 4u; b++) {
                    uint qv = (word >> (b * 8u)) & 0xFFu;
                    uint l = u * 4u + b;
                    float w0 = d1 * float(qv & 0xFu) - m1;
                    acc += w0 * float(a[s * 256u + j + l]);
                    float w1 = d2 * float(qv >> 4u) - m2;
                    acc += w1 * float(a[s * 256u + j + 32u + l]);
                }
            }
        }
    }

    // Reduce the 4 lanes of each row via shared memory; lane 0 writes the result.
    partial[tid] = acc;
    barrier();
    if (lane == 0u && live) {
        float sum = partial[tid] + partial[tid + 1u] + partial[tid + 2u] + partial[tid + 3u];
        y[o] = float16_t(sum);
    }
}
