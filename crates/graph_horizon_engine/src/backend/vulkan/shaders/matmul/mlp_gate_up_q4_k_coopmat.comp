#version 450
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// AGENTS deroga K: kernel numerico della sola operazione gate/up Q4_K cooperativa.

/*
 * Shared-A concurrent MLP gate/up projection for the measured 3B prefill shape.
 * Four subgroups own two M16 tiles for gate and two for up. They stage the two
 * activation tiles once, dequantize distinct Q4_K weight tiles, accumulate with
 * native 16x16x16 FP16xFP16->FP32 MMA, and store separate FP16 outputs. Routing
 * guarantees M=32, N=9216, K=3072 and preserves the generic fallback.
 */
layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer A { float16_t a[]; };
layout(std430, binding = 1) readonly buffer WG { uint qg[]; };
layout(std430, binding = 2) readonly buffer WU { uint qu[]; };
layout(std430, binding = 3) writeonly buffer YG { float16_t yg[]; };
layout(std430, binding = 4) writeonly buffer YU { float16_t yu[]; };

layout(push_constant) uniform P { uint in_dim; uint out_dim; uint n; } p;

const uint T = 16u;
const uint POSITION_TILES = 2u;
const uint PROJECTIONS = 2u;

shared float16_t as_[POSITION_TILES * T * T];
shared float16_t bs[PROJECTIONS * T * T];
shared float cs[PROJECTIONS * POSITION_TILES * T * T];

uint gb(uint projection, uint b) {
    uint word = projection == 0u ? qg[b >> 2u] : qu[b >> 2u];
    return (word >> ((b & 3u) * 8u)) & 0xFFu;
}

float hf(uint projection, uint b) {
    return unpackHalf2x16(gb(projection, b) | (gb(projection, b + 1u) << 8u)).x;
}

void scale_min(uint projection, uint sco, uint j, out uint sc, out uint mn) {
    if (j < 4u) {
        sc = gb(projection, sco + j) & 63u;
        mn = gb(projection, sco + j + 4u) & 63u;
    } else {
        uint hi = gb(projection, sco + j + 4u);
        uint lo = gb(projection, sco + j - 4u);
        sc = (hi & 0xFu) | ((lo >> 6u) << 4u);
        mn = (hi >> 4u) | ((gb(projection, sco + j) >> 6u) << 4u);
    }
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint subgroup = tid / 32u;
    uint lane = tid % 32u;
    uint projection = subgroup / POSITION_TILES;
    uint position_tile = subgroup % POSITION_TILES;
    uint worker = tid % 64u;
    uint nsb = p.in_dim / 256u;
    uint col_base = gl_WorkGroupID.x * 32u + position_tile * T;
    uint row_base = gl_WorkGroupID.y * T;
    uint a_offset = position_tile * T * T;
    uint b_offset = projection * T * T;
    uint c_offset = subgroup * T * T;

    coopmat<float, gl_ScopeSubgroup, T, T, gl_MatrixUseAccumulator> acc =
        coopmat<float, gl_ScopeSubgroup, T, T, gl_MatrixUseAccumulator>(0.0);

    for (uint kbase = 0u; kbase < p.in_dim; kbase += T) {
        // Exactly one workgroup-wide load/stage for both projection owners.
        for (uint li = tid; li < POSITION_TILES * T * T; li += 128u) {
            uint tile_li = li % (T * T);
            uint tile = li / (T * T);
            uint mm = tile_li / T;
            uint kk = tile_li % T;
            uint gcol = gl_WorkGroupID.x * 32u + tile * T + mm;
            as_[li] = gcol < p.n ? a[gcol * p.in_dim + kbase + kk] : float16_t(0.0);
        }

        uint nn = worker % T;
        uint kk0 = worker / T;
        uint grow = row_base + nn;
        if (grow < p.out_dim) {
            uint k0 = kbase + kk0;
            uint block = (grow * nsb + (k0 >> 8u)) * 144u;
            uint rem256 = k0 & 255u;
            uint rem64 = rem256 & 63u;
            uint group = rem256 >> 6u;
            uint sc, mn;
            scale_min(projection, block + 4u, group * 2u + (rem64 >> 5u), sc, mn);
            float ds = hf(projection, block) * float(sc);
            float dm = hf(projection, block + 2u) * float(mn);

            // Preserve the retained four-value metadata reuse for each weight.
            for (uint slot = 0u; slot < 4u; slot++) {
                uint li = worker + slot * 64u;
                uint rem = (rem64 + slot * 4u) & 63u;
                uint packed = gb(projection, block + 16u + group * 32u + (rem & 31u));
                uint qv = rem < 32u ? packed & 0xFu : packed >> 4u;
                bs[b_offset + li] = float16_t(ds * float(qv) - dm);
            }
        } else {
            for (uint slot = 0u; slot < 4u; slot++)
                bs[b_offset + worker + slot * 64u] = float16_t(0.0);
        }
        barrier();

        coopmat<float16_t, gl_ScopeSubgroup, T, T, gl_MatrixUseA> matA;
        coopmat<float16_t, gl_ScopeSubgroup, T, T, gl_MatrixUseB> matB;
        coopMatLoad(matA, as_, a_offset, T, gl_CooperativeMatrixLayoutRowMajor);
        coopMatLoad(matB, bs, b_offset, T, gl_CooperativeMatrixLayoutRowMajor);
        acc = coopMatMulAdd(matA, matB, acc);
        barrier();
    }

    coopMatStore(acc, cs, c_offset, T, gl_CooperativeMatrixLayoutRowMajor);
    barrier();
    for (uint li = lane; li < T * T; li += 32u) {
        uint mm = li / T;
        uint nn = li % T;
        uint gcol = col_base + mm;
        uint grow = row_base + nn;
        if (gcol < p.n && grow < p.out_dim) {
            float16_t value = float16_t(cs[c_offset + li]);
            if (projection == 0u)
                yg[gcol * p.out_dim + grow] = value;
            else
                yu[gcol * p.out_dim + grow] = value;
        }
    }
}
