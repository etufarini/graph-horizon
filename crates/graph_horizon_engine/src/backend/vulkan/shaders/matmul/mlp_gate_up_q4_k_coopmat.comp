#version 450
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// AGENTS deroga K: kernel numerico della sola operazione gate/up Q4_K cooperativa.

/*
 * Shared-A phased MLP gate/up projection for the measured 3B prefill shape.
 * Two subgroups own adjacent M16 tiles. For each K tile they stage A once,
 * retain its cooperative fragment, prepare distinct gate/up Q4_K weight tiles,
 * and consume them sequentially with native 16x16x16 FP16xFP16->FP32 MMA. Both
 * accumulators stay FP32 and outputs narrow only on store. Generic fallback remains.
 */
layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer A { float16_t a[]; };
layout(std430, binding = 1) readonly buffer WG { uint qg[]; };
layout(std430, binding = 2) readonly buffer WU { uint qu[]; };
layout(std430, binding = 3) writeonly buffer YG { float16_t yg[]; };
layout(std430, binding = 4) writeonly buffer YU { float16_t yu[]; };

layout(push_constant) uniform P { uint in_dim; uint out_dim; uint n; } p;

const uint T = 16u;
const uint POSITION_TILES = 2u;

shared float16_t as_[POSITION_TILES * T * T];
shared float16_t bs[2u * T * T];
shared float cs[2u * POSITION_TILES * T * T];

uint gb(uint projection, uint b) {
    uint word = projection == 0u ? qg[b >> 2u] : qu[b >> 2u];
    return (word >> ((b & 3u) * 8u)) & 0xFFu;
}

float hf(uint projection, uint b) {
    return unpackHalf2x16(gb(projection, b) | (gb(projection, b + 1u) << 8u)).x;
}

void scale_min(uint projection, uint sco, uint j, out uint sc, out uint mn) {
    if (j < 4u) {
        sc = gb(projection, sco + j) & 63u;
        mn = gb(projection, sco + j + 4u) & 63u;
    } else {
        uint hi = gb(projection, sco + j + 4u);
        uint lo = gb(projection, sco + j - 4u);
        sc = (hi & 0xFu) | ((lo >> 6u) << 4u);
        mn = (hi >> 4u) | ((gb(projection, sco + j) >> 6u) << 4u);
    }
}

void stage_weight(uint projection, uint worker, uint row_base, uint kbase, uint nsb) {
    uint nn = worker % T;
    uint kk0 = worker / T;
    uint grow = row_base + nn;
    if (grow < p.out_dim) {
        uint k0 = kbase + kk0;
        uint block = (grow * nsb + (k0 >> 8u)) * 144u;
        uint rem256 = k0 & 255u;
        uint rem64 = rem256 & 63u;
        uint group = rem256 >> 6u;
        uint sc, mn;
        scale_min(projection, block + 4u, group * 2u + (rem64 >> 5u), sc, mn);
        float ds = hf(projection, block) * float(sc);
        float dm = hf(projection, block + 2u) * float(mn);

        // Preserve four-value metadata reuse for each independently-owned weight.
        for (uint slot = 0u; slot < 4u; slot++) {
            uint li = worker + slot * 64u;
            uint rem = (rem64 + slot * 4u) & 63u;
            uint packed = gb(projection, block + 16u + group * 32u + (rem & 31u));
            uint qv = rem < 32u ? packed & 0xFu : packed >> 4u;
            bs[projection * T * T + li] = float16_t(ds * float(qv) - dm);
        }
    } else {
        for (uint slot = 0u; slot < 4u; slot++)
            bs[projection * T * T + worker + slot * 64u] = float16_t(0.0);
    }
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint subgroup = tid / 32u;
    uint lane = tid % 32u;
    uint nsb = p.in_dim / 256u;
    uint col_base = gl_WorkGroupID.x * 32u + subgroup * T;
    uint row_base = gl_WorkGroupID.y * T;
    uint a_offset = subgroup * T * T;
    uint gate_c_offset = subgroup * T * T;
    uint up_c_offset = (POSITION_TILES + subgroup) * T * T;

    coopmat<float, gl_ScopeSubgroup, T, T, gl_MatrixUseAccumulator> gate_acc =
        coopmat<float, gl_ScopeSubgroup, T, T, gl_MatrixUseAccumulator>(0.0);
    coopmat<float, gl_ScopeSubgroup, T, T, gl_MatrixUseAccumulator> up_acc =
        coopmat<float, gl_ScopeSubgroup, T, T, gl_MatrixUseAccumulator>(0.0);

    for (uint kbase = 0u; kbase < p.in_dim; kbase += T) {
        for (uint li = lane; li < T * T; li += 32u) {
            uint mm = li / T;
            uint kk = li % T;
            uint gcol = col_base + mm;
            as_[a_offset + li] = gcol < p.n
                ? a[gcol * p.in_dim + kbase + kk]
                : float16_t(0.0);
        }
        stage_weight(0u, tid, row_base, kbase, nsb);
        stage_weight(1u, tid, row_base, kbase, nsb);
        barrier();

        // The A fragment remains live and is reused by the sequential up MMA.
        coopmat<float16_t, gl_ScopeSubgroup, T, T, gl_MatrixUseA> matA;
        coopmat<float16_t, gl_ScopeSubgroup, T, T, gl_MatrixUseB> matB;
        coopMatLoad(matA, as_, a_offset, T, gl_CooperativeMatrixLayoutRowMajor);
        coopMatLoad(matB, bs, 0u, T, gl_CooperativeMatrixLayoutRowMajor);
        gate_acc = coopMatMulAdd(matA, matB, gate_acc);
        coopMatLoad(matB, bs, T * T, T, gl_CooperativeMatrixLayoutRowMajor);
        up_acc = coopMatMulAdd(matA, matB, up_acc);
        barrier();
    }

    coopMatStore(gate_acc, cs, gate_c_offset, T, gl_CooperativeMatrixLayoutRowMajor);
    coopMatStore(up_acc, cs, up_c_offset, T, gl_CooperativeMatrixLayoutRowMajor);
    barrier();
    for (uint li = lane; li < T * T; li += 32u) {
        uint mm = li / T;
        uint nn = li % T;
        uint gcol = col_base + mm;
        uint grow = row_base + nn;
        if (gcol < p.n && grow < p.out_dim) {
            yg[gcol * p.out_dim + grow] = float16_t(cs[gate_c_offset + li]);
            yu[gcol * p.out_dim + grow] = float16_t(cs[up_c_offset + li]);
        }
    }
}
