#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

// INT8 per-token asymmetric quantize-on-write: mirrors kv_cache/int8.rs
// BIT-EXACTLY (I3). One workgroup per (token, kv_head) vector; the workgroup
// quantizes the vector for K and then for V. Per vector: min/max reduced in
// f32 (order-independent), scale = (max-min) * (1.0/255.0) in f32 (a MULTIPLY,
// never a division: Vulkan guarantees correctly-rounded fmul/fadd but only
// 2.5 ULP for fdiv), both rounded to f16 (RTE via float16_t, like the CPU's
// f32_to_f16), then coding against the ROUNDED constants: code = largest q in
// 0..=255 with v >= min + (q-0.5)*scale, each boundary one `precise` multiply
// + add (no FMA contraction), found by the same binary search as the CPU
// reference. The caches are bound as uint words: payload codes are packed
// 4/word (byte j in bits 8*(j%4) of word j/4, little-endian like the CPU
// bytes) and the 4-byte metadata is one word min_bits | scale_bits<<16. Byte
// offsets arrive from the CPU side (kv_cache::layout, D6) and are word-aligned
// (payload: multiples of head_dim; meta: multiples of 4).
layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer K { float16_t k[]; };
layout(std430, binding = 1) readonly buffer V { float16_t v[]; };
layout(std430, binding = 2) buffer KC { uint kc[]; };
layout(std430, binding = 3) buffer VC { uint vc[]; };

layout(push_constant) uniform P {
    uint payload_offset; // BYTE origin of the token's first vector payload
    uint meta_offset;    // BYTE origin of the token's first vector metadata
    uint vectors;        // kv_heads vectors of head_dim values each
    uint head_dim;
} p;

const uint MAX_G = 8u; // subgroups per 128-lane workgroup, S >= 16

shared float sh_min[MAX_G];
shared float sh_max[MAX_G];
shared uint sh_code[128];
// The packed f16 (min, scale) word, published by lane 0 and re-read by every
// lane THROUGH shared memory: the cross-invocation round-trip forces the
// compiler to materialize the f32->f16 rounding — a same-lane
// `float(float16_t(x))` chain may legally be folded back to `x`, which would
// code against the UNROUNDED constants and break CPU parity (I3).
shared uint sh_meta;

// The largest code q in 0..=255 with v >= min + (q-0.5)*scale (scale > 0):
// binary search over the monotone boundaries, each evaluated with one rounded
// multiply and one rounded add. `precise` forbids FMA contraction so the
// boundary bits equal the CPU reference's mul-then-add exactly (I3).
uint code_of(float v, float mnr, float scr) {
    uint code = 0u;
    for (uint step = 128u; step > 0u; step >>= 1) {
        uint cand = code + step;
        if (cand <= 255u) {
            precise float t = (float(cand) - 0.5) * scr;
            precise float boundary = mnr + t;
            if (v >= boundary) code = cand;
        }
    }
    return code;
}

// Quantizes one head_dim-wide vector from `src[src_base..]` into the cache
// words: codes at byte `pbyte`, metadata word at byte `mbyte`.
void quantize(uint lid, float x, bool live, uint pbyte, uint mbyte, uint hd, bool is_k) {
    // f32 min/max across the workgroup: subgroup reduce, then lane-0-of-
    // subgroup partials combined by every lane (barrier-bounded, exact).
    float mn = subgroupMin(live ? x : 3.4e38);
    float mx = subgroupMax(live ? x : -3.4e38);
    if (subgroupElect()) { sh_min[gl_SubgroupID] = mn; sh_max[gl_SubgroupID] = mx; }
    barrier();
    float gmn = 3.4e38, gmx = -3.4e38;
    for (uint g = 0u; g < gl_NumSubgroups; g++) {
        gmn = min(gmn, sh_min[g]);
        gmx = max(gmx, sh_max[g]);
    }
    // f16-round min and scale (RTE via float16_t), publish the PACKED BITS via
    // shared memory, then every lane codes against the widened stored values —
    // exactly what the CPU reference and dequant read. Multiply by the
    // reciprocal constant, never divide (see the header note on fdiv).
    if (lid == 0u) {
        precise float scale = (gmx - gmn) * (1.0 / 255.0);
        sh_meta = uint(float16BitsToUint16(float16_t(gmn)))
            | (uint(float16BitsToUint16(float16_t(scale))) << 16);
    }
    barrier();
    uint m = sh_meta;
    float mnr = float(uint16BitsToFloat16(uint16_t(m & 0xFFFFu)));
    float scr = float(uint16BitsToFloat16(uint16_t(m >> 16)));
    uint code = 0u;
    if (live && scr != 0.0) {
        code = code_of(x, mnr, scr);
    }
    sh_code[lid] = code;
    barrier();
    // Lanes 0..hd/4 pack 4 codes per word; lane 0 writes the metadata word.
    if (lid < hd / 4u) {
        uint w = sh_code[lid * 4u]
            | (sh_code[lid * 4u + 1u] << 8)
            | (sh_code[lid * 4u + 2u] << 16)
            | (sh_code[lid * 4u + 3u] << 24);
        if (is_k) { kc[pbyte / 4u + lid] = w; } else { vc[pbyte / 4u + lid] = w; }
    }
    if (lid == 0u) {
        if (is_k) { kc[mbyte / 4u] = m; } else { vc[mbyte / 4u] = m; }
    }
    barrier(); // sh_* reused by the V pass
}

void main() {
    uint vec = gl_WorkGroupID.x;
    if (vec >= p.vectors) return;
    uint lid = gl_LocalInvocationID.x;
    bool live = lid < p.head_dim;

    uint src = vec * p.head_dim + lid;
    uint pbyte = p.payload_offset + vec * p.head_dim;
    uint mbyte = p.meta_offset + vec * 4u;

    quantize(lid, live ? float(k[src]) : 0.0, live, pbyte, mbyte, p.head_dim, true);
    quantize(lid, live ? float(v[src]) : 0.0, live, pbyte, mbyte, p.head_dim, false);
}
