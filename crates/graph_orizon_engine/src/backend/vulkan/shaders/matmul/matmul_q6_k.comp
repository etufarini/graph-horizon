#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// AGENTS deroga K: kernel denso Q6_K per la proiezione batch-1.

// Q6_K matmul: y = W * a, batch 1. Four invocations cooperate on each output
// row, one per contiguous 64-value quarter of every 256-value super-block. The
// activation block is staged once per 64 output rows, each lane accumulates in
// FP32, and lane zero writes the four-way reduction as FP16.
//
// Q6_K block (210 bytes): ql[128] (low 4 bits) | qh[64] (high 2 bits) |
// scales[16] (int8) | d(f16). Each 6-bit quant q is (ql_nibble | qh_2bits<<4),
// recentered by -32, scaled by d * scales[is].
layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer A { float16_t a[]; };   // [in_dim]
layout(std430, binding = 1) readonly buffer W { uint q[]; };        // Q6_K bytes
layout(std430, binding = 2) writeonly buffer Y { float16_t y[]; };  // [out_dim]

layout(push_constant) uniform P { uint in_dim; uint out_dim; } p;

shared float asb[256];
shared float partial[256];

uint gb(uint b) { return (q[b >> 2u] >> ((b & 3u) * 8u)) & 0xFFu; }
float hf(uint b) { return unpackHalf2x16(gb(b) | (gb(b + 1u) << 8u)).x; }
// Signed int8 scale at byte b.
int s8(uint b) { int v = int(gb(b)); return v >= 128 ? v - 256 : v; }

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint row_local = tid >> 2u;
    uint lane = tid & 3u;
    uint o = gl_WorkGroupID.x * 64u + row_local;
    bool live = o < p.out_dim;
    uint nsb = p.in_dim / 256u;
    uint seg = lane >> 1u;
    uint pair = lane & 1u;
    uint nibble_shift = pair * 4u;
    uint scale_shift = pair * 4u;
    uint activation_shift = seg * 128u + pair * 64u;
    float acc = 0.0;

    for (uint s = 0u; s < nsb; s++) {
        asb[tid] = float(a[s * 256u + tid]);
        barrier();

        if (live) {
            uint blk = (o * nsb + s) * 210u;
            uint qlo = blk;
            uint qho = blk + 128u;
            uint sco = blk + 192u;
            float d = hf(blk + 208u);
            uint qlb = qlo + seg * 64u;
            uint qhb = qho + seg * 32u;
            uint scb = sco + seg * 8u;
            for (uint l = 0u; l < 32u; l++) {
                uint is = l / 16u;
                uint lo0 = gb(qlb + l);
                uint lo1 = gb(qlb + l + 32u);
                uint h = gb(qhb + l);
                int q0 = int(((lo0 >> nibble_shift) & 0xFu) |
                             (((h >> scale_shift) & 3u) << 4u)) - 32;
                int q1 = int(((lo1 >> nibble_shift) & 0xFu) |
                             (((h >> (scale_shift + 2u)) & 3u) << 4u)) - 32;
                acc += d * float(s8(scb + is + scale_shift)) * float(q0) *
                       asb[activation_shift + l];
                acc += d * float(s8(scb + is + scale_shift + 2u)) * float(q1) *
                       asb[activation_shift + l + 32u];
            }
        }
        // Every lane must finish reading the staged block before it is replaced.
        barrier();
    }

    partial[tid] = acc;
    barrier();
    if (lane == 0u && live) {
        float sum = partial[tid] + partial[tid + 1u] + partial[tid + 2u] + partial[tid + 3u];
        y[o] = float16_t(sum);
    }
}
